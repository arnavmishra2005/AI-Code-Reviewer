# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/ai-code-reviewer
# Atlas:  mongodb+srv://<username>:<password>@<cluster-url>/ai-code-reviewer?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/ai-code-reviewer

# Secret used to sign JWT tokens - use a long random string
JWT_SECRET=replace_this_with_a_long_random_secret

# API key for the AI provider (Anthropic Claude used by default)
AI_API_KEY=your_anthropic_api_key_here

# Port the backend server runs on
PORT=5000

# Comma separated list of allowed frontend origins (for CORS)
CLIENT_URL=http://localhost:5173
